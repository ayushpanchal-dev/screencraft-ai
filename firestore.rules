rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is from an authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    // Projects Collection Rules
    match /projects/{projectId} {
      // Anyone from anywhere can view/preview projects without login
      allow read: if true;
      
      // Only authenticated admin users can create, update, or delete project documents
      allow create, update, delete: if isAdmin();
    }
    
  }
}
