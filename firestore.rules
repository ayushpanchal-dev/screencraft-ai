rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is from an authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    // Projects Collection Rules
    match /projects/{projectId} {
      // Unauthenticated public visitors can read projects where type == 'public'
      // Authenticated admin users can read any project (public, professional, private)
      allow read: if resource == null || resource.data.type == 'public' || resource.data.type == null || isAdmin();
      
      // Only authenticated admin users can create, update, or delete project documents
      allow create, update, delete: if isAdmin();
    }
    
  }
}
